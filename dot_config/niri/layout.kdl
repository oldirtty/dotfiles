cursor {
    xcursor-theme "macOS-White"
    xcursor-size 24
}

layout {
    gaps 10

    preset-column-widths {
        proportion 0.25
        proportion 0.375
        proportion 0.5
        proportion 0.625
        proportion 0.75
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    border {
        on
        width 3
    }

    focus-ring {
        off
        width 0
    }

    shadow {
        on
        softness 0
        spread 0
        offset x=6 y=6
        draw-behind-window false
        inactive-color "transparent"
    }

    tab-indicator {
        on
        width 10
        gap 8
        gaps-between-tabs 8
        corner-radius 0
        length total-proportion=0.75
        position "bottom"
        place-within-column
    }
    struts {
        top    -3 // - border size
        left   0
        bottom 6
        right  3
    }
    default-column-width
}
// ── Window corner radius ────
window-rule {
    geometry-corner-radius 0
}
// ── Bolder shadow to floating windows ────
window-rule {
    match is-floating=true
    shadow {
        spread 0
        offset x=10 y=10
    }
}
// ── No focus ring in other workspaces ────
/- window-rule {
    match is-active=false

    focus-ring {
        off
    }
}

recent-windows {
    // off
    debounce-ms 750
    open-delay-ms 150

    highlight {
        padding 16
        corner-radius 0
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }

        Mod+Tab         { next-window; }
        Mod+Shift+Tab   { previous-window; }
        Mod+grave       { next-window filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}
overview {
    zoom 0.5
    workspace-shadow {
        off
    }
}

prefer-no-csd
