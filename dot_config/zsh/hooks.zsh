# Accent color generated by Noctalia
export NOCTALIA_ACCENT=$(cat ~/.cache/noctalia/accent.hex 2>/dev/null || echo "white")
TRAPUSR1() {
  export NOCTALIA_ACCENT=$(<~/.cache/noctalia/accent.hex)
  if zle; then
    (( $+functions[_omp_precmd] )) && _omp_precmd
    zle reset-prompt
  fi
}

# Window title
zmodload zsh/datetime zsh/mathfunc

preexec() {
  _cmd_start=$EPOCHREALTIME
}

precmd() {
  print -Pn "\e]2;%n@%m:%~\a"

  if [[ -n "$_cmd_start" && -n "$TMUX" ]]; then
    local elapsed_ms=$(( (EPOCHREALTIME - _cmd_start) * 1000 ))
    unset _cmd_start

    local formatted=""
    if (( elapsed_ms >= 500 )); then
      if (( elapsed_ms >= 60000 )); then
        local total_s=$(( int(elapsed_ms / 1000) ))
        formatted="$(( total_s / 60 ))m $(( total_s % 60 ))s"
      elif (( elapsed_ms >= 1000 )); then
        printf -v formatted "%.3fs" "$(( elapsed_ms / 1000.0 ))"
      else
        printf -v formatted "%.0fms" "$elapsed_ms"
      fi
    fi

    if [[ -n "$formatted" || -n "$_cmd_shown" ]]; then
      _cmd_shown=$formatted
      tmux set-option -p @cmd_duration "$formatted" \; refresh-client -S &!
    fi
  fi
}
