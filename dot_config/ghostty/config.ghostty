#### Theme ####
config-file = ?auto/theme.ghostty

# auto-generated theme
theme = Noctalia
palette-generate=true
selection-foreground = cell-background

#### Font configuration ####
font-family = SauceCodePro Nerd Font
font-size = 11

#### Terminal features ####
scrollbar = never
mouse-hide-while-typing = true
confirm-close-surface = false
unfocused-split-opacity=0.4
selection-word-chars = " \t'\"│`|:;,()[]{}<>"

window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true

#### Shell Integration ####
shell-integration-features = no-cursor

#### Window configuration ####
window-decoration = none
background-opacity = 1
window-padding-x = 12
window-padding-y = 12

#### Cursor configuration ####
cursor-style = bar
adjust-cursor-thickness = 1

#### Keybinds ####
keybind = f11=toggle_fullscreen
keybind = ctrl+shift+r=reload_config
keybind = f10=text:xdg-open . &\n
# clear buffer line
keybind = ctrl+shift+backspace=text:\x15

# split
keybind = alt+s=new_split
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right

keybind = alt+shift+up=new_split:up
keybind = alt+shift+down=new_split:down
keybind = alt+shift+left=new_split:left
keybind = alt+shift+right=new_split:right

#### Unbinds ####
keybind = ctrl+shift+q=unbind
