{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "position": "top",
    "color": {
      "1": "red",
      "2": "green",
      "3": "yellow",
      "4": "blue",
      "5": "magenta",
      "6": "cyan",
      "7": "white",
      "8": "bright_black",
      "9": "{{ colors.primary.default.hex }}"
    },
    "padding": {
      "top": 0
    },
    "width": 32
  },
  "display": {
    "key": {
      "paddingLeft": 2,
      "width": 14
    },
    "color": "{{ colors.primary.default.hex }}",
    "percent": { "type": 3 },
    "separator": " "
  },

  "modules": [
    // {
    //   "type": "title",
    //   "key": "{icon}  user",
    //   "keyIcon": "",
    //   "format": "{user-name}",
    // },
    // {
    //   "type": "title",
    //   "format": "{#light_black}------------"
    // },
    {
      "type": "host",
      "key": "  pc",
      "format": "{name}"
    },
    {
      "type": "command",
      "key": "  os",
      "text": "bash -c 'printf \"\\033[37m%s\\033[0m  \\033[90m[%s]\\033[0m\\n\" \"$(. /etc/os-release && echo $NAME | awk \"{print \\$1}\")\" \"$(uname -r)\"'"
    },
    // {
    //    "type": "os",
    //    "key": "󰻀  os",
    //    "format": "{pretty-name} {#light_black}[{arch}]"
    // },
    // {
    //    "type": "kernel",
    //    "key": "  kernel",
    //    "format": "{sysname}  {#light_black}[v{release}]"
    // },
    {
      "type": "packages",
      "key": "󰏖  pkgs",
      "disabled": ["flatpak"]
    },
    // {
    //    "type": "uptime",
    //    "key": "󰥔  up",
    //    "format": "{?days}{days} days, {?}{hours} hours, {minutes} mins"
    // },
    {
      "type": "disk",
      "key": "  age",
      "format": "{days-of-year} days",
      "folders": "/"
    },
    {
      "type": "de",
      "key": "  de ",
      "format": "{pretty-name}  {#light_black}[v{version}]"
    },
    {
      "type": "wm",
      "key": "{icon}  wm ",
      "format": "{pretty-name}  {#light_black}[v{version}]"
    },
    {
      "type": "shell",
      "key": "  sh",
      "format": "{pretty-name}  {#light_black}[v{version}]"
    },
    {
      "type": "terminal",
      "key": "󰊠  term",
      "format": "{pretty-name}  {#light_black}[v{version}]"
    },
    {
      "type": "display",
      "key": "󰍹  disp",
      "format": "{width}×{height}{#dim_white}@{#}{refresh-rate}Hz  {#light_black}[{name}]"
    },
    {
      "type": "board",
      "key": "{icon}  board",
      "format": "{name} {#light_black}"
    },
    {
      "type": "cpu",
      "key": "{icon}  cpu",
      "format": "{name} {#light_black}"
    },
    {
      "type": "gpu",
      "key": "󰢮  gpu",
      "detectionMethod": "auto",
      "driverSpecific": true,
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{icon}  ram",
      "format": "{used} / {total}  {#light_black}({percentage}{#light_black})"
    },
    // {
    //    "type": "swap",
    //    "key": "󱘶  swap",
    //    "format": "{used} / {total}  {#light_black}({percentage}{#light_black})"
    // },
    {
      "type": "disk",
      "key": "{icon}  disk{5}",
      "hideFS": "vfat",
      "format": "{size-used~,-4} / {size-total}  {#light_black}[{filesystem}]"
    },
    {
      "type": "colors",
      "key": "{icon}  colors",
      "symbol": "circle"
    }
  ]
}
