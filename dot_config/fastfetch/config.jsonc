{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "position": "left",
    "color": {
      "1": "red",
      "2": "green",
      "3": "yellow",
      "4": "blue",
      "5": "magenta",
      "6": "cyan",
      "7": "white",
      "8": "bright_black",
      "9": "{{ colors.primary.default.hex }}"
    },
    "padding": {
      "top": 0,
      "left": 2
    }
  },
  "display": {
    "key": {
      "paddingLeft": 0,
      "type": "string"
    },
    "color": {
      "keys": "{{ colors.primary.default.hex }}",
      "separator": "white"
    },
    "percent": { "type": 3 },
    "separator": " "
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{#light_black}@{host-name-colored} {#}{cwd}"
    },
    // {
    //   "type": "command",
    //   "keyIcon": "",
    //   "key": "os    ",
    //   "text": ". /etc/os-release; printf '%s \\033[90m(%s)\\033[0m' \"${NAME%% *}\" \"$(uname -r)\""
    // },
    {
      "type": "os",
      "keyIcon": "",
      "key": "os   ",
      "format": "{name:6} {version-id}"
    },
    {
      "type": "kernel",
      "key": "kern ",
      "format": "{release~,-16} {#light_black}({arch})"
    },
    {
      "type": "packages",
      "key": "pkgs ",
      "format": "{?pacman}{pacman} {#light_black}(pacman){#}{?}{?rpm}{rpm} {#light_black}(rpm){#}{?}{?guix-system}{guix-system} (system), {?}{?guix-home}{guix-home} (home), {?}{?guix-user}{guix-user} (user){?}{?xbps}{xbps} (xbps){?}"
    },
    {
      "type": "de",
      "keyIcon": "",
      "key": "de   ",
      "format": "{pretty-name} {#light_black}(v{version})"
    },
    {
      "type": "shell",
      "keyIcon": "",
      "key": "sh   ",
      "format": "{pretty-name} {#light_black}(v{version})"
    },
    {
      "type": "wm",
      "key": "wm   ",
      "format": "{pretty-name} {?version}{#light_black}(v{version}){?}"
    },
    // {
    //   "type": "memory",
    //   "key": "mem   ",
    //   "format": "{used~,-4} / {total} {#light_black}({percentage}{#light_black})"
    // },
    // {
    //   "type": "disk",
    //   "key": "disk{5} ",
    //   "hideFS": "vfat",
    //   "format": "{size-used~,-4} / {size-total} {#light_black}({filesystem})"
    // },
    {
      "type": "disk",
      "keyIcon": "",
      "key": "age  ",
      "format": "{days-of-year} days",
      "folders": "/"
    },
    { "type": "break"},
    {
      "type": "colors",
      "key": " ",
      "symbol": "circle"
    }
  ]
}
