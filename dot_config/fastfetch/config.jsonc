{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "position": "top",
    "color": {
      "1": "red",
      "2": "green",
      "3": "yellow",
      "4": "blue",
      "5": "magenta",
      "6": "cyan",
      "7": "white",
      "8": "bright_black",
      "9": "{{ colors.primary.default.hex }}"
    },
    "padding": {
      "top": 0
    }
  },
  "display": {
    "key": {
      // "width": 16,
      "paddingLeft": 3,
      "type": "icon"
    },
    "color": "{{ colors.primary.default.hex }}",
    "percent": { "type": 3 },
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "format": "   {user-name-colored}{#light_black}@{host-name-colored}"
    },
    {
      "type": "host",
      "keyIcon": "",
      "key": "pc",
      "format": "{name}"
    },
    {
      "type": "command",
      "keyIcon": "",
      "key": "os",
      "text": "bash -c 'source /etc/os-release; echo -e \"\\e[37m${NAME%% *}\\e[0m  \\e[90m[$(uname -r)]\\e[0m\"'"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "disabled": ["flatpak"]
    },
    {
      "type": "disk",
      "keyIcon": "",
      "key": "ag",
      "format": "{days-of-year} days",
      "folders": "/"
    },
    {
      "type": "de",
      "keyIcon": "",
      "key": "de",
      "format": "{pretty-name}  {#light_black}[v{version}]"
    },
    {
      "type": "shell",
      "keyIcon": "",
      "key": "sh",
      "format": "{pretty-name}  {#light_black}[v{version}]"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}  {#light_black}[v{version}]"
    },
    {
      "type": "terminal",
      "keyIcon": "",
      "key": "term",
      "format": "{pretty-name}  {#light_black}[v{version}]"
    },
    {
      "type": "display",
      "key": "disp",
      "format": "{width}×{height}{#dim_white}@{#}{refresh-rate}Hz  {#light_black}[{name}]"
    },
    {
      "type": "board",
      "key": "mobo",
      "format": "{name} {#light_black}"
    },
    {
      "type": "cpu",
      "key": "cp",
      "format": "{name} {#light_black}"
    },
    {
      "type": "gpu",
      "key": "gp",
      "detectionMethod": "auto",
      "driverSpecific": true,
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "ram",
      "format": "{used~,-4} / {total}  {#light_black}({percentage}{#light_black})"
    },
//  {
//     "type": "swap",
//     "key": "󱘶  swap      ",
//     "format": "{used} / {total}  {#light_black}({percentage}{#light_black})"
//  },
    {
      "type": "disk",
      "key": "disk{5}",
      "hideFS": "vfat",
      "format": "{size-used~,-4} / {size-total}  {#light_black}[{filesystem}]"
    },
    {
      "type": "colors",
      "key": "colors",
      "symbol": "circle"
    }
  ]
}
