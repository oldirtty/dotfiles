#!/usr/bin/env bash
set -euo pipefail

FONT_DIR="{{ .chezmoi.homeDir }}/.local/share/fonts"
mkdir -p "$FONT_DIR"

FLAG_FILE="$FONT_DIR/.nerd-fonts-installed"

if [ ! -f "$FLAG_FILE" ]; then
  echo "Installing all Nerd Fonts..."
  tmp_dir=$(mktemp -d)
  pushd "$tmp_dir" > /dev/null

  curl -sL https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/install.sh -o install.sh
  chmod u+x install.sh
  ./install.sh install all

  popd > /dev/null
  rm -rf "$tmp_dir"
  touch "$FLAG_FILE"
else
  echo "Nerd Fonts already installed. Skipping..."
fi

SS_DIR="$FONT_DIR/SunghyunSans"
if [ ! -d "$SS_DIR" ]; then
  echo "Installing font: Sunghyun Sans"
  tmp=$(mktemp)
  tmp_extract=$(mktemp -d)
  curl -fsSL https://github.com/anaclumos/sunghyun-sans/releases/latest/download/SunghyunSans-OTF.zip -o "$tmp"
  unzip -q "$tmp" -d "$tmp_extract"
  mkdir -p "$SS_DIR"
  find "$tmp_extract" -name '*.otf' -exec cp {} "$SS_DIR"/ \;
  rm -rf "$tmp" "$tmp_extract"
fi

fc-cache -f
