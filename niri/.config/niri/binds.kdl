// user/binds.kdl
binds {
    // Apps
    Mod+T { spawn-sh "$TERMINAL"; }
    Mod+F { spawn-sh "$FILE_MANAGER"; }
    Mod+B { spawn-sh "$BROWSER"; }

    // Screenshots
    Mod+Shift+S { screenshot show-pointer=false; }
    Print { screenshot show-pointer=false; }
    Alt+Print { screenshot-window show-pointer=false; }
    Ctrl+Print { screenshot-screen show-pointer=false; }
    Alt+XF86Launch1 { screenshot-window show-pointer=false; }
    Ctrl+XF86Launch1 { screenshot-screen show-pointer=false; }
    XF86Launch1 { screenshot show-pointer=false; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // Window Management
    // Focus
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Ctrl+Up { focus-workspace-up; }
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+J { focus-workspace-down; }
    Mod+Ctrl+K { focus-workspace-up; }
    // Move
    Mod+Shift+H { move-column-left-or-to-monitor-left; }
    Mod+Shift+L { move-column-right-or-to-monitor-right; }
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Shift+K { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up { move-window-up-or-to-workspace-up; }
    Mod+Shift+Left { move-column-left-or-to-monitor-left; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }

    // Window/Column actions
    Mod+Shift+Ctrl+J { move-column-to-workspace-down; }
    Mod+Shift+Ctrl+K { move-column-to-workspace-up; }
    Mod+Shift+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Shift+Ctrl+Up { move-column-to-workspace-up; }

    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }
    Mod+E { expand-column-to-available-width; }
    Mod+M { maximize-column; }
    Mod+Shift+M { fullscreen-window; }
    Mod+C { center-visible-columns; }
    Mod+Shift+C { center-column; }
    Mod+G { toggle-window-floating; }
    Mod+Shift+W { toggle-column-tabbed-display; }
    Mod+Shift+G { switch-focus-between-floating-and-tiling; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Q repeat=false { close-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Equal { set-column-width "+12.5%"; }
    Mod+Minus { set-column-width "-12.5%"; }
    Mod+Shift+Equal { set-window-height "+16.666%"; }
    Mod+Shift+Minus { set-window-height "-16.666%"; }
    // Utilities
    Mod+Tab repeat=false { toggle-overview; }
    Mod+Slash { show-hotkey-overlay; }
    Mod+Shift+E { quit; }
}

recent-windows {
    binds {
        Alt+Tab allow-inhibiting=false { next-window; }
    }
}
