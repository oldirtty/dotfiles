layout {
    always-center-single-column

    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    border {
        on
        width 2
    }

    focus-ring {
        on
        width 2
    }

    shadow {
        on
        softness 30
        spread 5
        color "#00000070"
        inactive-color "#00000020"
        draw-behind-window true
    }
}

prefer-no-csd
